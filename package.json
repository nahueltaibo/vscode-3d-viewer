{
  "name": "o3dv-viewer",
  "displayName": "3D Model Viewer (Online3DViewer)",
  "description": "View STEP, STL, 3MF, OBJ, glTF and other 3D models inside VS Code, powered by Online3DViewer.",
  "version": "0.2.0",
  "publisher": "nahueltaibo",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nahueltaibo/vscode-3d-viewer"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "o3dv.viewer",
        "displayName": "3D Model Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.{stl,STL}"
          },
          {
            "filenamePattern": "*.{3mf,3MF}"
          },
          {
            "filenamePattern": "*.{glb,GLB}"
          },
          {
            "filenamePattern": "*.{3ds,3DS}"
          },
          {
            "filenamePattern": "*.{fbx,FBX}"
          },
          {
            "filenamePattern": "*.{ply,PLY}"
          },
          {
            "filenamePattern": "*.{amf,AMF}"
          }
        ]
      },
      {
        "viewType": "o3dv.viewer.text",
        "displayName": "3D Model Viewer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.{obj,OBJ}"
          },
          {
            "filenamePattern": "*.{off,OFF}"
          },
          {
            "filenamePattern": "*.{gltf,GLTF}"
          },
          {
            "filenamePattern": "*.{dae,DAE}"
          },
          {
            "filenamePattern": "*.{wrl,WRL}"
          },
          {
            "filenamePattern": "*.{bim,BIM}"
          }
        ]
      }
    ],
    "configuration": {
      "title": "3D Model Viewer",
      "properties": {
        "o3dv.upAxis": {
          "type": "string",
          "enum": [
            "auto",
            "Y",
            "Z"
          ],
          "default": "auto",
          "description": "Up axis for new views. 'auto' uses Z for STEP, IGES and BREP, which CAD tools export Z-up, and Y for everything else, because the importer already turns Z-up mesh formats such as STL and 3MF into Y-up."
        },
        "o3dv.showEdges": {
          "type": "boolean",
          "default": false,
          "description": "Draw feature edges on top of the shaded model."
        },
        "o3dv.edgeThreshold": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 180,
          "description": "Minimum angle in degrees between faces for an edge to be drawn."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "online-3d-viewer": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "occt-import-js": "^0.0.22",
    "typescript": "^7.0.2"
  }
}
